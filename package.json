{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@react-pdf/renderer": "^3.1.14",
    "ajv": "^8.12.0",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.6.5",
    "i18next": "^23.7.11",
    "lucide-react": "^0.503.0",
    "next": "14.1.1",
    "react": "^18.2.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^18.2.0",
    "react-github-calendar": "^3.2.2",
    "react-i18next": "^13.5.0",
    "react-icons": "^4.12.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-parallax-tilt": "^1.7.42",
    "react-pdf": "^6.2.2",
    "react-slick": "^0.30.1",
    "react-tsparticles": "^2.12.2",
    "serve": "^14.2.4",
    "slick-carousel": "^1.8.1",
    "tsparticles-slim": "^2.12.0",
    "typewriter-effect": "^2.18.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3043",
    "lint": "next lint"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.14",
    "core-js": "^3.41.0",
    "eslint-config-next": "^15.3.1",
    "eslint-plugin-import": "^2.31.0",
    "postcss": "^8.4.31",
    "sass": "^1.87.0",
    "tailwindcss": "^3.3.0",
    "webpack": "^5.89.0"
  },
  "reactSnap": {
    "inlineCss": true,
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    },
    "source": "build",
    "destination": "build",
    "include": [
      "/",
      "/about",
      "/projects",
      "/resume"
    ],
    "removeBlobs": false,
    "removeScriptTags": false,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "cacheAjaxRequests": true,
    "preloadImages": true,
    "preconnectThirdParty": true,
    "http2PushManifest": true,
    "puppeteerIgnoreHTTPSErrors": true,
    "fixWebpackChunksIssue": true,
    "skipThirdPartyRequests": false,
    "waitFor": 2000
  }
}
